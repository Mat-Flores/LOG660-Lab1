' Alt + D : Visualiser le diagramme
'
' Transformation du schema conceptuel (T1), en 3FN.
'   Specialisation {disjointe, complete} : Utilisateur + Client + Employe.
'   Composition 1-1 : la PK d'Adresse et de CarteCredit est la FK.
'   Attribut multivalue lienBandeAnnonce : table BandeAnnonce.
'   Associations *-* : FilmGenre, FilmPays, FilmScenariste.
'   Realisateur (multiplicite 1) : FK NOT NULL dans Film.
'   Une copie est sortie de l'inventaire tant qu'une location a dateRetour nulle.
'   Pas de colonne redondante pour cet etat.
' Les NOT NULL reprennent les multiplicites [1] de T1. Les lignes XML
' citees en tete de T1 (film sans realisateur, personne sans photo, etc.)
' seront refusees a l'insertion.
' biographie est un CLOB : la plus longue biographie de personnes_latin1.xml
' fait 54277 caracteres, au-dela de la limite VARCHAR2(4000).
' Les fleches pointent vers la table referencee par la cle etrangere.
' (PK) cle primaire. (FK Table) cle etrangere. (UNIQUE) cle candidate.

@startuml WebflixSchemaRelationnel
title Webflix — Schéma relationnel (Tâche 2, Labo 1, LOG660)

skinparam classAttributeIconSize 0

' ===================== UTILISATEURS DU SYSTÈME =====================
object Utilisateur {
  {field} idUtilisateur : NUMBER (PK)
  {field} nomFamille : VARCHAR2(40) NOT NULL
  {field} prenom : VARCHAR2(40) NOT NULL
  {field} courriel : VARCHAR2(80) NOT NULL (UNIQUE)
  {field} telephone : VARCHAR2(20) NOT NULL
  {field} dateNaissance : DATE NOT NULL
  {field} motDePasse : VARCHAR2(50) NOT NULL
}

object Adresse {
  {field} idUtilisateur : NUMBER (PK, FK)
  {field} numeroCivique : VARCHAR2(10) NOT NULL
  {field} rue : VARCHAR2(40) NOT NULL
  {field} ville : VARCHAR2(40) NOT NULL
  {field} province : VARCHAR2(2) NOT NULL
  {field} codePostal : VARCHAR2(7) NOT NULL
}

object Client {
  {field} idUtilisateur : NUMBER (PK, FK)
  {field} codeForfait : VARCHAR2(1) NOT NULL (FK)
}

object CarteCredit {
  {field} idUtilisateur : NUMBER (PK, FK)
  {field} type : VARCHAR2(10) NOT NULL
  {field} numero : VARCHAR2(19) NOT NULL
  {field} dateExpiration : DATE NOT NULL
  {field} cvv : VARCHAR2(4) NOT NULL
}

object Employe {
  {field} idUtilisateur : NUMBER (PK, FK)
  {field} matricule : VARCHAR2(7) NOT NULL (UNIQUE)
}

object Forfait {
  {field} code : VARCHAR2(1) (PK)
  {field} cout : NUMBER(5,2) NOT NULL
  {field} locationsMax : NUMBER(2) NOT NULL
  {field} dureeMaxJours : NUMBER(4)
}

Adresse --> Utilisateur
Client --> Utilisateur
Employe --> Utilisateur
CarteCredit --> Client
Client --> Forfait

' ===================== CATALOGUE DE FILMS =====================
object Film {
  {field} idFilm : NUMBER (PK)
  {field} idRealisateur : NUMBER NOT NULL (FK Personne)
  {field} titre : VARCHAR2(120) NOT NULL
  {field} anneeSortie : NUMBER(4) NOT NULL
  {field} dureeMinutes : NUMBER(4) NOT NULL
  {field} langueOriginale : VARCHAR2(30) NOT NULL
  {field} resume : VARCHAR2(1000) NOT NULL
  {field} urlAffiche : VARCHAR2(200) NOT NULL
}

object BandeAnnonce {
  {field} idFilm : NUMBER (PK, FK)
  {field} lien : VARCHAR2(300) (PK)
}

object Genre {
  {field} nom : VARCHAR2(20) (PK)
}

object Pays {
  {field} nom : VARCHAR2(30) (PK)
}

object Personne {
  {field} idPersonne : NUMBER (PK)
  {field} nom : VARCHAR2(60) NOT NULL
  {field} dateNaissance : DATE NOT NULL
  {field} lieuNaissance : VARCHAR2(120) NOT NULL
  {field} photo : VARCHAR2(200) NOT NULL
  {field} biographie : CLOB NOT NULL
}

object Interpretation {
  {field} idFilm : NUMBER (PK, FK)
  {field} idPersonne : NUMBER (PK, FK)
  {field} nomPersonnage : VARCHAR2(80) (PK)
}

object FilmScenariste {
  {field} idFilm : NUMBER (PK, FK Film)
  {field} idPersonne : NUMBER (PK, FK Personne)
}

object FilmGenre {
  {field} idFilm : NUMBER (PK, FK Film)
  {field} nomGenre : VARCHAR2(20) (PK, FK Genre)
}

object FilmPays {
  {field} idFilm : NUMBER (PK, FK Film)
  {field} nomPays : VARCHAR2(30) (PK, FK Pays)
}

Film --> Personne
BandeAnnonce --> Film
FilmGenre --> Film
FilmGenre --> Genre
FilmPays --> Film
FilmPays --> Pays
Interpretation --> Film
Interpretation --> Personne
FilmScenariste --> Film
FilmScenariste --> Personne

' ===================== INVENTAIRE ET LOCATIONS =====================
object Copie {
  {field} codeCopie : VARCHAR2(20) (PK)
  {field} idFilm : NUMBER NOT NULL (FK Film)
}

object Location {
  {field} idLocation : NUMBER (PK)
  {field} idUtilisateur : NUMBER NOT NULL (FK Client)
  {field} codeCopie : VARCHAR2(20) NOT NULL (FK Copie)
  {field} dateLocation : DATE NOT NULL
  {field} dateRetour : DATE
}

Copie --> Film
Location --> Client
Location --> Copie

@enduml
